# scheff-writer configuration. Copy to .env (gitignored) or set in your
# container environment. Only WRITER_ROOT and WRITER_TOKEN are required.

# Folder that holds 04_Projects/ (pieces) and optionally 06_Reference/
# (profile.md and tone/ samples used for voice matching).
WRITER_ROOT=/data/writing

# Listen address. The container default is :8445; the binary default
# is 127.0.0.1:8445.
WRITER_LISTEN=:8445

# Shared sign-in token, at least 16 characters. Generate one with:
#   openssl rand -hex 24
WRITER_TOKEN=change-me-to-a-long-random-string

# Any OpenAI-compatible chat-completions endpoint (LiteLLM, OpenAI,
# a local gateway). Base URL without /v1.
WRITER_LLM_URL=http://litellm:4000
WRITER_LLM_KEY=change-me
WRITER_MODEL=your-model-name

# Optional: add sources by URL through a forager service (0.4 or newer,
# github.com/scheff-of-staff/forager), which fetches pages and PDFs
# and refuses private/internal addresses. Without it, pasted text and
# PDF upload still work.
WRITER_FORAGER_URL=
WRITER_FORAGER_TOKEN=

# Optional JSON API for scripts and other services (see README, "JSON
# API"). Off unless WRITER_API_TOKEN is set. It must be at least 16
# characters and differ from WRITER_TOKEN: openssl rand -hex 24
WRITER_API_TOKEN=
# Comma-separated model aliases an API request may pick. WRITER_MODEL
# is always allowed and is the default.
WRITER_API_MODELS=
# API calls in flight at once; extra calls get 429. Default 4.
WRITER_API_MAX_CONCURRENT=

# Optional links in the header back to a host application.
WRITER_HOME_URL=
# Prefix the project slug is appended to, e.g. https://host:8444/project?slug=
WRITER_PROJECT_URL=

# Local development only:
# WRITER_ALLOW_NO_AUTH=1     run without a token (bind to localhost!)
# WRITER_INSECURE_COOKIE=1   allow the session cookie over plain http
# WRITER_PROJECTS_DIR=04_Projects
# WRITER_REFERENCE_DIR=06_Reference
